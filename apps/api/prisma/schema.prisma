// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  name         String
  passwordHash String
  role         Role           @default(USER)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  providerConfigs ProviderConfig[]
  conversations Conversation[]
  projects      Project[]
  agentRuns     AgentRun[]
  approvals     Approval[]

  @@index([email])
  @@map("users")
}

model AgentRun {
  id          String      @id @default(cuid())
  userId      String
  projectId   String
  prompt      String
  status      String      @default("RUNNING") // RUNNING, PAUSED_FOR_APPROVAL, COMPLETED, FAILED, CANCELLED
  activeAgent String      @default("ARCHITECT") // ARCHITECT, DEVELOPER, TESTER, DEBUGGER, SECURITY, UI_UX, PM
  stepCount   Int         @default(0)
  maxSteps    Int         @default(25)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  steps       AgentStep[]
  approvals   Approval[]

  @@index([userId])
  @@index([projectId])
  @@map("agent_runs")
}

model AgentStep {
  id          String    @id @default(cuid())
  runId       String
  agentRole   String
  thought     String?
  action      String?   // tool name
  actionInput Json?
  output      String?
  status      String    @default("SUCCESS") // SUCCESS, ERROR, REQUIRES_APPROVAL
  createdAt   DateTime  @default(now())

  run         AgentRun  @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@map("agent_steps")
}

model Approval {
  id          String    @id @default(cuid())
  runId       String
  userId      String
  actionType  String    // FILE_DELETE, INSTALL_DEPS, EXECUTE_CMD
  details     Json
  status      String    @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?

  run         AgentRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([userId])
  @@map("approvals")
}

model Project {
  id          String        @id @default(cuid())
  userId      String
  name        String
  description String?
  template    String        // react, node, python, nextjs, java
  status      String        @default("READY") // READY, GENERATING, ERROR
  workspaceDir String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  files       ProjectFile[]
  tasks       ProjectTask[]

  @@index([userId])
  @@map("projects")
}

model ProjectFile {
  id        String   @id @default(cuid())
  projectId String
  path      String   // relative path within project
  size      Int      @default(0)
  isDir     Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, path])
  @@index([projectId])
  @@map("project_files")
}

model ProjectTask {
  id          String   @id @default(cuid())
  projectId   String
  title       String
  description String?
  status      String   @default("COMPLETED") // PENDING, IN_PROGRESS, COMPLETED, FAILED
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_tasks")
}

model Conversation {
  id        String    @id @default(cuid())
  userId    String
  title     String
  modelId   String    @default("gemini-2.0-flash")
  provider  String    @default("gemini")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([userId])
  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           String       // user, assistant, system
  content        String
  tokensUsed     Int?         @default(0)
  createdAt      DateTime     @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("messages")
}

model ProviderConfig {
  id             String   @id @default(cuid())
  userId         String
  provider       String   // openai, gemini, anthropic, groq, mistral, deepseek, ollama, custom
  name           String
  endpoint       String?
  encryptedApiKey String?
  iv             String?
  authTag        String?
  maskedApiKey   String?
  isDefault      Boolean  @default(false)
  status         String   @default("UNVERIFIED") // CONNECTED, ERROR, UNVERIFIED
  lastError      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider, name])
  @@index([userId])
  @@map("provider_configs")
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
  replacedBy String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model TestRun {
  id          String     @id @default(cuid())
  projectId   String
  userId      String
  status      String     @default("PENDING") // PENDING, RUNNING, PASSED, FAILED, ERROR
  framework   String     @default("vitest") // vitest, pytest, jest, junit
  totalTests  Int        @default(0)
  passed      Int        @default(0)
  failed      Int        @default(0)
  skipped     Int        @default(0)
  durationMs  Int        @default(0)
  stdout      String?
  stderr      String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  cases       TestCase[]

  @@index([projectId])
  @@index([userId])
  @@map("test_runs")
}

model TestCase {
  id         String   @id @default(cuid())
  runId      String
  name       String
  suite      String?
  status     String   @default("PASSED") // PASSED, FAILED, SKIPPED
  durationMs Int      @default(0)
  errorMsg   String?
  stackTrace String?
  createdAt  DateTime @default(now())

  run TestRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@map("test_cases")
}

model DebugSession {
  id          String   @id @default(cuid())
  projectId   String
  userId      String
  errorMsg    String
  stackTrace  String?
  suggestion  String?
  resolved    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
  @@index([userId])
  @@map("debug_sessions")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  details   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

enum Role {
  USER
  ADMIN
}

