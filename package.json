{
  "name": "nexora-ai-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "NEXORA AI - Universal AI Software Development Platform",
  "scripts": {
    "build": "pnpm --filter @nexora/* run build",
    "lint": "pnpm --filter @nexora/* run lint",
    "typecheck": "pnpm --filter @nexora/* run typecheck",
    "test": "pnpm --filter @nexora/* run test",
    "dev:web": "pnpm --filter @nexora/web run dev",
    "dev:api": "pnpm --filter @nexora/api run dev",
    "dev": "pnpm --parallel run dev"
  },
  "devDependencies": {
    "@types/node": "^20.17.19",
    "typescript": "^5.7.3",
    "prettier": "^3.5.1"
  },
  "packageManager": "pnpm@12.18.0"
}

